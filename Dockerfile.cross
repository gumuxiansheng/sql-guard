# 交叉编译 ARM64 Linux musl 静态二进制
# 在 x86_64 Alpine 容器中交叉编译到 aarch64-unknown-linux-musl
#
# 用法：
#   docker buildx build -f Dockerfile.cross --platform linux/amd64 --output type=local,dest=target/arm64-linux .

FROM rust:1.80-alpine AS builder

# 安装 musl 交叉编译工具链 + git（如需 vendoring）
RUN apk add --no-cache musl-dev aarch64-linux-musl-gcc

# 配置 cargo 交叉编译链接器
ENV CARGO_TARGET_AARCH64_UNKNOWN_LINUX_MUSL_LINKER=aarch64-linux-musl-gcc
ENV CC_aarch64_unknown_linux_musl=aarch64-linux-musl-gcc
ENV CXX_aarch64_unknown_linux_musl=aarch64-linux-musl-g++
ENV AR_aarch64_unknown_linux_musl=aarch64-linux-musl-ar

# 添加 ARM64 musl target
RUN rustup target add aarch64-unknown-linux-musl

WORKDIR /build
COPY . .

# 交叉编译 release 版本
RUN cargo build --release --target aarch64-unknown-linux-musl --locked && \
    aarch64-linux-musl-strip target/aarch64-unknown-linux-musl/release/sqlguard

# 输出阶段：仅提取二进制
FROM scratch
COPY --from=builder /build/target/aarch64-unknown-linux-musl/release/sqlguard /sqlguard
