# ================================================================================
# SQL 方言 dialect（★ 根级设置：必须位于任何 [section] 表头之前，否则会被并入子表而失效）
# ================================================================================
# check 流程使用的 SQL 方言，影响 sqlparser 解析。
# - generic（默认）：兼容大多数标准 SQL
# - mysql：支持 MySQL 专有语法（INSERT IGNORE / ON DUPLICATE KEY UPDATE / 反引号标识符等）
# - postgresql：支持 PostgreSQL 扩展语法（保持干净，不再默认回退 Oracle）
# - ansi：严格 ANSI SQL
# - oracle：支持 Oracle 兼容语法（CONNECT BY / MINUS / (+) 外连接 / DUAL / ROWNUM 等）
# - gaussdb：基于 PG 内核，兼容部分 Oracle/MySQL 语法（推荐用于 GaussDB / openGauss 等
#   「PG 内核 + Oracle/MySQL 外壳」的国产库）。解析前自动做词法级归一化重写
#   （MINUS→EXCEPT、SYSDATE→CURRENT_TIMESTAMP、NVL→COALESCE、FROM dual→子查询、
#   反引号→双引号），再用 PostgreSqlDialect 解析，AST 语义 100% 来自 PG，
#   避免原「PG→Oracle 回退」对标识符大小写等 PG 语义的污染。
#   重写后仍解析失败的语句（如 CONNECT BY、(+) 外连接）自动回退 Oracle 兜底。
#
# 可用 CLI `--dialect gaussdb` 临时覆盖配置。
# dialect = "generic"

# ================================================================================
# 方言回退链第二候选 dialect_fallback（混合方言场景）
# ================================================================================
# 某条语句用主 dialect 解析失败时，按「主方言 → 本字段（若存在）→ Generic」顺序
# 用后续方言重试，首个成功即采用；全部失败才记 PARSE_ERROR。
# - 不配置时：gaussdb 主方言默认回退到 oracle（覆盖重写层未处理的复杂构造），
#   其余主方言（含 postgresql）默认仅回退到 Generic。
# - CLI `--dialect-fallback generic` 可显式关闭回退（链退化为「主方言 → Generic」）。
# 详解与端到端行为见 docs/dialect-fallback.md。
# dialect_fallback = "oracle"

[structure]
paths = [
  "sql/ddl",
  "sql/dml",
  "sql/others",
]
strict = true
# init 子命令会在项目内创建 config/rules/（规则脚本），strict 结构校验时放行
# vendor/ 是 `init --with-default-pack` 落规则包（vendor/rules/rules-core/ 与
# vendor/rules/rules-gaussdb/）的目录，同样放行——否则每个包化项目每次 check
# 都会刷一批 "vendor/... (unexpected)"
allow_extra = [".gitkeep", "config/", "vendor/"]

[classification]
default_type = "other"

[[classification.rules]]
name = "ddl-by-dir"
pattern = "**/ddl/**"
type = "ddl"
priority = 10

[[classification.rules]]
name = "dml-by-dir"
pattern = "**/dml/**"
type = "dml"
priority = 10

[[classification.rules]]
name = "other-by-others-dir"
pattern = "**/others/**"
type = "other"
priority = 10

[[classification.rules]]
name = "sql-by-ext"
pattern = "*.sql"
type = "sql"
priority = 0

# ================================================================================
# 规则配置：单独拆分到 sqlguard.rules.toml，避免主配置文件随规则增多而过长。
# 不写本行时，工具也会自动在同目录查找 sqlguard.rules.toml。
# ================================================================================
rules_file = "sqlguard.rules.toml"

# ================================================================================
# 规则包 [rule_packs]（规则与引擎分开发版）
# ================================================================================
# 规则包 = 一个目录（<search_path>/<name>/），含 rules-pack.toml 清单 + *.rhai 脚本。
# 包可独立发版、独立选版本，项目按需选用；包内规则与本地 sqlguard.rules.toml 共存。
#
# 合并优先级（低 → 高）：
#   引擎内置兜底 < packs（按声明顺序，靠后覆盖靠前）< 项目本地规则 < overrides
#
# search_paths：包搜索路径（相对配置文件目录或绝对路径）。
#   包位于 <search_path>/<name>/rules-pack.toml。
#   环境变量 SQLGUARD_RULE_PATH（; 分隔）会追加在其后，便于 CI 注入共享包。
# packs：生效的规则包。
#   { name }                 按 search_paths 查找
#   { name, path }           直接指向包根（path 优先）
#   { name, version }        声明期望版本，与实际不符时报错
# overrides：按 id 覆盖包内/本地规则的 enabled / severity / params（最高优先级）。
#   id 可写规范 id（gaussdb:GDB001）或裸 id（GDB001，命中多条时取优先级最高者）；
#   引用不存在的 id 会报错（防 typo）。
# allow_remote：远程包来源。当前尚不支持远程拉取，设为 true 会直接报错
#   （避免"看起来放开了、其实没生效"）。
#
# 规则 id 命名空间：包清单 [pack].namespace = "gaussdb" → 该包规则对外 id 变为
#   gaussdb:GDB001，多个包可各自拥有 DML001 而互不冲突。未设 namespace 的来源
#   （含项目本地规则、内联 [[rules]]）保持裸 id，现有用法完全不变。
#   CLI 过滤写法（--rules / --exclude-rules）：
#     gaussdb:GDB001   精确匹配规范 id
#     GDB001           裸 id，跨 namespace 命中所有同名短 id
#     gaussdb:*        该 namespace 下全部规则
#     GDB*             裸前缀，匹配短 id 前缀
#   详见 docs/rule-pack-design.md §5.3。
#
# [rule_packs]
# search_paths = [".sqlguard/rules", "vendor/rules"]
# packs = [
#   { name = "rules-core" },                          # 按 search_paths 查找
#   { name = "rules-gaussdb", version = "1.3.0" },    # 声明期望版本
#   { name = "rules-local", path = "./my-rules" },    # 直接指向包根
# ]
# allow_remote = false
#
# [[rule_packs.overrides]]
# id = "gaussdb:GDB001"
# enabled = false
# severity = "error"
# [rule_packs.overrides.params]
# max_join_tables = 5

[output]
# 可用格式：plain（控制台）/ json / html / sarif（接 GitHub/Azure/GitLab code scanning）
formats = ["plain", "json", "html", "sarif"]

# MyBatis Mapper 模式：扫描 XML 中的 <select>/<insert>/<update>/<delete>。
# 缺省或 enabled = false 时完全保持现有行为（仅扫描 .sql/.ddl/.dml）。
# paths：扫描根目录，支持通配符（含 * / ? / [ / { 即视为 glob，相对扫描根匹配
#   目录与 XML 文件，正斜杠分隔）：
#     paths = ["src/main/resources/mapper"]        # 字面量目录（原语义）
#     paths = ["src/**/mapper"]                    # 任意层级的 mapper 目录
#     paths = ["**/legacy/legacy_report.xml"]      # 直接指定文件
#   glob 命中目录：按 patterns 递归收集其下 XML；命中文件：直接收录（不受 patterns 过滤）。
#   多个条目命中同一文件自动去重；glob 遍历同样跳过 [scan] exclude_dirs 黑名单。
# patterns：目录内文件过滤 glob，默认 ["**/*Mapper.xml"]。
# [mapper]
# enabled = true
# paths = ["src/main/resources/mapper"]
# patterns = ["**/*Mapper.xml", "**/*.xml"]
#
# statement_type_mapping：MyBatis 标签 → SqlGuard script_type 映射。
# 缺省时所有标签映射到 "dml"（向后兼容）。可把 select 单独映射到 "query"，
# 让 SELECT 走 query 类型规则，与 DML 分别治理：
# [mapper.statement_type_mapping]
# select = "query"
# insert = "dml"
# update = "dml"
# delete = "dml"

# ================================================================================
# 文件扫描行为配置 [scan]
# ================================================================================
# 控制白名单扫描根与黑名单跳过目录，避免递归进入 .git/target/node_modules 等大目录。
#
# exclude_dirs：递归扫描时跳过的目录名（按名称匹配，任意层级生效）。
#   默认值见下，未配置 [scan] 段时也按默认黑名单生效。
#   适用于：SQL 脚本扫描、Mapper XML 扫描、目录结构校验三个场景。
#
# paths：SQL 脚本扫描白名单（相对配置文件目录或绝对路径）。
#   为空时回退到 [structure].paths，仍为空则扫描整个 target_dir（兜底）。
#   指定后只扫描这些目录下的 .sql/.ddl/.dml，散落在白名单外的 SQL 会被忽略。
#
# encoding：扫描文件的编码格式（SQL 脚本 + Mapper XML 统一使用），默认 utf-8。
#   历史项目（如 Windows 老系统导出）的脚本可能是 GBK / GB18030 / UTF-16 等，
#   可用 WHATWG 编码标签指定，如 encoding = "gbk"（等效 --encoding gbk）。
#   文件带 BOM 时按 BOM 判定编码并剥离 BOM（BOM 优先于本配置）。
#   配置非 UTF-8 编码时，FILE001「必须 UTF-8 无 BOM」策略检查自动跳过。
#   支持的标签：utf-8 / gbk / gb2312 / gb18030 / big5 / shift_jis（sjis, cp932）
#   / euc-jp / euc-kr / utf-16le / utf-16be / utf-32le / utf-32be
#   / windows-1252（latin1, iso-8859-1）/ ascii 等。
#
# [scan]
# paths = []
# exclude_dirs = [
#   ".git", ".svn", ".hg", ".bzr",       # 版本控制元数据
#   "target", "node_modules", "build", "dist", "out",  # 构建产物
#   ".idea", ".vscode",                   # IDE 配置
# ]
# encoding = "utf-8"

# ================================================================================
# 文件格式检查 [file_check]
# ================================================================================
# 对扫描到的每个文件做字节级检查（独立于 SQL 语法规则）：
#   FILE001  编码必须为 UTF-8 且不带 BOM（severity = error，必须）
#   FILE002  换行符应为 LF（severity = warning，提示）
# 两条检查归入 file-format 分组，可用 --exclude-rules FILE001,FILE002
# 或 --exclude-groups file-format 临时关闭。
# 缺省（未写 [file_check] 段）时按下方默认值启用。
# 注：当 [scan] encoding 配置为非 UTF-8（如 gbk）时，FILE001 自动跳过——
#   文件预期就是该编码，不再执行「必须 UTF-8」策略检查。
#
# enabled              总开关，false 时完全跳过文件格式检查。
# check_encoding       是否检查 UTF-8 无 BOM（FILE001）。
# check_line_ending    是否检查换行符为 LF（FILE002）。
# encoding_severity    编码违规级别，默认 error（必须）。
# line_ending_severity 换行符违规级别，默认 warning（提示）。

[file_check]
enabled = true
check_encoding = true
check_line_ending = true
encoding_severity = "error"
line_ending_severity = "warning"

# （SQL 方言已在文件顶部根级设置，此处不再重复——
#  若写在这里会被并入 [file_check] 子表而失效，故保持根级唯一来源。）

# ================================================================================
# 备份回滚自动生成 [rollback]
# ================================================================================
# 对每条 DDL/DML 语句自动生成 backup.sql / rollback.sql / rollback-manifest.json，
# 配合发布平台在变更失败时回滚。详见 docs/backup-rollback-design.md。
#
# 总开关默认 false：不启用时 check 流程不触发回滚生成，保持纯检查工具行为。
# 启用后通过 `sqlguard gen-rollback` 子命令生成回滚脚本。
#
# [rollback]
# enabled = false
# dialect = "mysql"                  # mysql / postgresql / gaussdb（影响标识符引用、LIKE 语法、RENAME 等）
# backup_mode = "auto"               # auto（DML 增量 + ALTER 按上下文）/ full / incremental
# backup_file = "backup.sql"         # ★ backup 子目录名（output_dir/backup/ 镜像输入目录结构）
# rollback_file = "rollback.sql"     # ★ rollback 子目录名（output_dir/rollback/ 镜像输入目录结构）
# manifest_file = "rollback-manifest.json"  # 全局汇总（output_dir 根目录）
# cleanup_file = "cleanup.sql"       # 全局汇总（output_dir 根目录）
# wrap_transaction = true            # 仅 PG 生效；MySQL DDL 隐式提交无效
# backup_table_prefix = "bks_"       # 与 DDL004 对齐
# backup_table_with_date = true      # bks_xxx_YYYYMMDD_NNNN
# backup_table_date_format = "%Y%m%d"
# cleanup_backup_tables_after_rollback = false  # 默认保留备份表便于审计
# lock_tables_during_backup = true   # 旧配置，保留兼容
#
# # ★ D1 锁策略（F14）
# lock_scope = "auto"                # auto / global / table / snapshot / none
# lock_timeout = 30                  # FTWRL 等待超时（秒）
# on_long_transaction = "abort"      # abort / warn / ignore
# long_transaction_threshold = 5     # 长事务阈值（秒）
#
# # ★ D2 binlog 控制（F16）
# disable_binlog_for_bks = true      # 旧配置，保留兼容
# binlog_strategy = "auto"           # auto / always / never
#
# # schema 漂移校验（F13）与分区表策略（F15）
# assert_on_schema_mismatch = "abort"  # abort / warn / ignore
# on_partitioned_table = "abort"       # abort / warn / fallback
#
# include_select = false             # Mapper 模式下是否对 SELECT 生成回滚
#
# # ★ D5 备份表保留天数（F19）
# backup_table_retention_days = 7
#
# # ★ D6 锁合并（N9）
# coalesce_locks = true
# coalesce_locks_mode = "conservative"  # conservative / aggressive
#
# # ★ R2 lock_scope=table 必须显式确认
# accept_table_lock_risk = false
#
# # ★ 表名大小写：源 SQL 中表名大小写混合时（如 Users），生成的 backup/rollback 脚本
# # # 会用方言引号（MySQL: `Users` / PG: "Users"）包裹表名，保留原始大小写，无需配置。
#
# # 显式主键声明（未声明时按 StmtInfo.create_table / bks_ JOIN 推断）
# # [[rollback.primary_keys]]
# # table = "users"
# # columns = ["id"]

# ================================================================================
# 文件级缓存 [cache]
# ================================================================================
# 对未修改的文件（mtime + size 不变）复用上次检查的 violations，
# 跳过解析与规则执行，大仓库重复 `sqlguard check` 时显著提速。
#
# 默认关闭。启用后缓存文件写到 target_dir 下的 .sqlguard-cache.json，
# 运行签名（配置 + 规则脚本 + 方言 + filter + 版本）变化时整体失效。
#
# 可用 CLI `--cache` / `--no-cache` 临时覆盖配置。
#
# [cache]
# enabled = false                    # 默认关闭
# cache_file = ".sqlguard-cache.json"
